# --- HTTP -------------------------------------------------------------------
PORT=8700
# Origin allowed by CORS. Must match where the React client is served from.
CLIENT_URL=http://localhost:8701

# --- Database ---------------------------------------------------------------
# "postgres" (default, production) or "memory" (pg-mem, used by the test suite).
DB_DIALECT=postgres
# Required when DB_DIALECT=postgres.
DB_URL=postgres://postgres:postgres@localhost:5432/fitco

# Run sequelize.sync() at boot. Turn off once real migrations exist.
DB_AUTO_SYNC=true
DB_POOL_MAX=10
DB_POOL_MIN=0

# --- Security ---------------------------------------------------------------
PASSWORD_HASHER=bcrypt
BCRYPT_ROUNDS=10

# --- Behaviour --------------------------------------------------------------
PAGE_DEFAULT_LIMIT=25
PAGE_MAX_LIMIT=100
LOG_LEVEL=info

# Populate the database with demo users at boot. Development only.
SEED_ON_BOOT=false
