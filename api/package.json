{
  "name": "fitco-users-api",
  "version": "1.0.0",
  "description": "Express + Sequelize REST API for the Fitco user-management take-home.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "cross-env NODE_ENV=test DB_DIALECT=memory BCRYPT_ROUNDS=4 node --test \"tests/**/*.test.js\"",
    "test:watch": "cross-env NODE_ENV=test DB_DIALECT=memory BCRYPT_ROUNDS=4 node --test --watch \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "pg": "^8.11.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.32.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "moment": "^2.31.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  }
}
